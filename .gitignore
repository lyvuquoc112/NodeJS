# =============================================================================
# .gitignore for Core Node.js Projects
# =============================================================================

# Dependencies & Packed Packages
node_modules/
.npm/
.pnpm-store/
.pnp
.pnp.*
*.tgz

# Environment Variables & Secrets
.env
.env.*
*.env
!.env.example
!.env.sample
!.env.template
*.pem
*.key
*.crt
*.p12
secrets.json
credentials.json

# Build, Native Addons & TypeScript Outputs
dist/
build/
Release/
Debug/
*.tsbuildinfo
.eslintcache
.prettiercache

# Node.js Runtime, REPL, PIDs & Diagnostic Reports
.node_repl_history
pids/
*.pid
*.seed
*.pid.lock
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
tmp/
temp/
*.tmp
*.temp
*.bak

# Logs & Testing
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
coverage/
.nyc_output/
*.lcov

# IDEs & Editors
**/.vscode/*
!**/.vscode/settings.json
!**/.vscode/tasks.json
!**/.vscode/launch.json
!**/.vscode/extensions.json
!**/.vscode/*.code-snippets
.idea/
*.iml
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Operating System
.DS_Store
._*
Thumbs.db
ehthumbs.db
Desktop.ini
*~
